# Caddy — TLS (auto Let's Encrypt) + path routing for the Supabase data plane.
# api.anutech.in must resolve to THIS VM's public IP, DNS-only (grey cloud) in
# Cloudflare, so Caddy can complete the ACME HTTP challenge and get a real cert.
#
# supabase-js calls  /auth/v1/*  /rest/v1/*  /storage/v1/*  — handle_path strips
# the matched prefix, so each backend receives the request at its own root.

api.anutech.in {
	encode gzip

	# GoTrue does NOT emit CORS headers of its own (hosted Supabase relies on its
	# edge/Kong for that). Behind Caddy the browser's preflight to /auth/v1/* came
	# back 204 with no Access-Control-Allow-Origin, so supabase-js getUser()/token
	# refresh died with "Failed to fetch" and the app showed "Not signed in" for a
	# fully-authenticated user. Caddy supplies CORS here. (REST is left alone —
	# PostgREST sets its own CORS, and a second ACAO would be a duplicate header the
	# browser rejects.) Auth uses a Bearer token, not cookies, so "*" is safe.
	handle_path /auth/v1/* {
		@preflight method OPTIONS
		handle @preflight {
			header {
				Access-Control-Allow-Origin "*"
				Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS, HEAD"
				Access-Control-Allow-Headers "Authorization, apikey, Content-Type, X-Client-Info, X-Supabase-Api-Version, Accept, Accept-Language, Content-Language, X-Requested-With"
				Access-Control-Max-Age "86400"
			}
			respond 204
		}
		handle {
			header {
				Access-Control-Allow-Origin "*"
				Access-Control-Expose-Headers "Content-Range, X-Supabase-Api-Version, Content-Length"
			}
			reverse_proxy auth:9999
		}
	}

	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}

	handle_path /storage/v1/* {
		reverse_proxy storage:5000
	}

	handle /healthz {
		respond "ok" 200
	}

	# Anything else → a plain 404 (no Supabase Studio is exposed).
	handle {
		respond "Not found" 404
	}
}
