# ============================================================================
#  Phase 2 · Self-hosted Supabase data plane on Cloud SQL — environment
# ----------------------------------------------------------------------------
#  Copy to `.env` ON THE VM and fill every __PLACEHOLDER__. NEVER commit .env.
#  Secrets live only here on the VM (like the DB passwords in Phase 1).
# ============================================================================

# ── Cloud SQL (the proxy connects to this; services talk to the proxy) ──────
CLOUDSQL_CONNECTION_NAME=resellsubsos-prod:asia-southeast1:resellersos-db
DB_NAME=resellersos

# ── DB role passwords (from Phase 1 — the private secrets note) ─────────────
AUTHENTICATOR_PW=__AUTHENTICATOR_PW__
AUTH_ADMIN_PW=__AUTH_ADMIN_PW__
STORAGE_ADMIN_PW=__STORAGE_ADMIN_PW__

# ── Supabase JWT secret + keys (from the Supabase dashboard → Settings → API)
#    REUSE the existing Supabase JWT Secret so current sessions/passwords stay
#    valid. The anon/service_role keys are the classic eyJ... (legacy) tokens.
JWT_SECRET=__JWT_SECRET__
ANON_KEY=__ANON_KEY__
SERVICE_ROLE_KEY=__SERVICE_ROLE_KEY__

# ── Public URLs ─────────────────────────────────────────────────────────────
API_EXTERNAL_URL=https://api.anutech.in
SITE_URL=https://anutech.in
ADDITIONAL_REDIRECT_URLS=https://anutech.in,https://anutech.in/*

# ── Google OAuth (login) — Supabase dashboard → Authentication → Providers ──
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=__GOOGLE_CLIENT_ID__
GOOGLE_SECRET=__GOOGLE_SECRET__
# In Google Cloud console, this redirect URI must be allow-listed:
#   https://api.anutech.in/auth/v1/callback

# ── Email / SMTP (auth emails: confirm, reset, invite) ──────────────────────
# Until SMTP is set, keep MAILER_AUTOCONFIRM=true so signups don't block on a
# confirmation email. Existing users log in with their password regardless.
MAILER_AUTOCONFIRM=true
SMTP_HOST=__SMTP_HOST__
SMTP_PORT=587
SMTP_USER=__SMTP_USER__
SMTP_PASS=__SMTP_PASS__
SMTP_ADMIN_EMAIL=support@anutech.in
SMTP_SENDER_NAME=Anutech Digital

# ── Image versions (bump if a newer known-good set is desired) ──────────────
POSTGREST_IMAGE=postgrest/postgrest:v12.2.3
GOTRUE_IMAGE=supabase/gotrue:v2.151.0
STORAGE_IMAGE=supabase/storage-api:v1.11.13
PROXY_IMAGE=gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.13.0
CADDY_IMAGE=caddy:2.8
