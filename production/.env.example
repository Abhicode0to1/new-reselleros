EMAIL_REPLY_TO="support@resellersos.com"

# ============================================================
# Email (plain SMTP relay) — the fallback when there is no Resend key
# ============================================================
# Added 11 Sep 2026. These are DMS's OWN variable names on purpose, so those
# credentials drop in with no renaming — unlike the ResellerClub pair, where
# DMS's RESELLERCLUB_ID is our RESELLERCLUB_RESELLER_ID.
#
# A relay does NOT report bounces: a 250 means it accepted the message, and a
# dead address bounces hours later into SMTP_USER's mailbox. So Resend still
# wins when both are set, and the relay is a floor rather than a preference.
#
# Mail leaves as SMTP_FROM (or SMTP_USER), NOT as EMAIL_FROM above — a relay may
# only send as the identity it authenticated with, and Gmail rejects or rewrites
# anything else. EMAIL_FROM becomes the Reply-To instead.
#
# Setting these makes the relay AVAILABLE. A workspace still has to select it on
# Settings → Integrations → Email sending (or `tenants.email_provider = 'smtp'`),
# because a RESEND_API_KEY that is present and invalid still counts as
# configured and would keep winning.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Leave blank to derive from the port: 465 means implicit TLS, anything else
# STARTTLS. Only set it when your relay disagrees with that convention.
SMTP_SECURE=""
# Optional. Only when the relay lets you send as a nicer address than the login
# (a Workspace "send mail as" alias). Defaults to SMTP_USER.
SMTP_FROM=""

# ============================================================
# Real purchases — the two switches that spend money
# ============================================================
# ⚠️ BOTH DEFAULT TO **ON**. Changed 11 Sep 2026 on Pardeep's instruction:
# "keep those turned on by default until admin ask otherwise". Before that they
# were opt-in and absence meant "order nothing".
#
# So LEAVE THESE UNSET for a normal production deployment. Ordering is allowed.
#
# What that means, said plainly: a fresh deployment, a lost config map, or a
# half-written env file used to produce "buy nothing" and now produces "buy".
# The remaining brake is CREDENTIALS — without RESELLERCLUB_* / DIRECTADMIN_*
# nothing can be ordered however open these are. A test run is also always
# shut, whatever these say (see src/lib/provisioning/live-gates.ts).
#
# To switch ordering OFF, set the flag to any of:
#   0  false  no  off  disabled  disable  none
# A value in NEITHER list (a typo like "disbled") is treated as ON and reported
# on the readiness screen as unrecognised — because the likeliest reason to type
# something odd here is trying to turn it off, and failing silently in that
# direction costs money.
#
# DOMAIN_REGISTER_LIVE — real ResellerClub domain registrations and renewals.
# HOSTING_TRIAL_LIVE   — real DirectAdmin account creation, including trials.
#
# Uncomment ONE of these only to stop that kind of purchase:
# DOMAIN_REGISTER_LIVE="0"
# HOSTING_TRIAL_LIVE="0"

# ============================================================
# AI (Gemini for in-app suggestions)
# ============================================================
GEMINI_API_KEY="..."
GEMINI_MODEL="gemini-1.5-flash"

# ============================================================
# Google Contacts sync (dedicated OAuth client — NOT the CSP one)
# People API + contacts scope. Redirect URI to register in Google Cloud:
#   {NEXT_PUBLIC_APP_URL}/api/integrations/google-contacts/callback
# ============================================================
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# ============================================================
# Monitoring
# ============================================================
# BOTH of these are needed, and they are the same DSN value twice.
#
# Only NEXT_PUBLIC_SENTRY_DSN was listed here until 23 Aug 2026, which is why SENTRY_DSN
# was never set on Cloud Run — lib/sentry.ts reads the non-public one, so the SERVER side
# has never reported a single exception. The prefixed one is what Next.js inlines into the
# browser bundle, and lib/sentry-client.ts reads that. Set one and half the app is still
# silent; which half depends on which one you set.
#
# A DSN is not a secret — it is a write-only ingest endpoint, which is why shipping it to
# the browser is the intended design.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Build-time only, for uploading source maps. Optional — without it, stack traces arrive
# minified but they still arrive.
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="resellersos.com"

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ============================================================
# AI Telecalling (Retell AI / Vapi) — added 25 Aug 2026
# ============================================================
# NOTHING HERE IS SET TODAY, and the feature is designed to behave sanely that way: with no
# provider configured, api/cron/ai-telecall-renewals still runs, still prepares every call,
# and files each one on the call record with a reason instead of dialling.
#
# These are DEPLOYMENT-level, not per-tenant, unlike the WhatsApp credentials in
# tenant_secrets. There is one vendor contract and one verified caller ID, and they belong to
# the deployment — see lib/telecall/provider.ts for the reasoning and for what changes if a
# second reseller ever brings their own number.
#
# ALL THREE of a provider's variables or none: a half-configured provider fails at the vendor
# with a 4xx that reads like an outage, so resolveTelecallProvider refuses instead and names
# what is missing.
#
# "retell" (default) or "vapi".
TELECALL_PROVIDER="retell"

# Retell. RETELL_API_KEY doubles as the webhook signing secret — Retell signs the post-call
# body with it (x-retell-signature), and the webhook route FAILS CLOSED without it: an
# unverified webhook is unauthenticated write access, and this one can trigger a quotation.
RETELL_API_KEY=""
RETELL_FROM_NUMBER=""
RETELL_AGENT_ID=""

# Vapi. The webhook secret is separate here because Vapi's x-vapi-secret is a plain shared
# secret rather than a signature — it proves the caller knows the secret and nothing about
# what they sent, which is weaker and is documented as weaker in lib/crypto/webhook-signature.ts.
VAPI_API_KEY=""
VAPI_PHONE_NUMBER_ID=""
VAPI_ASSISTANT_ID=""
VAPI_WEBHOOK_SECRET=""

# Optional. The number(s) this deployment calls FROM, so nothing dials back to us — a call to
# our own outbound number connects two robots. RETELL_FROM_NUMBER is used automatically; set
# this only if Vapi's caller ID differs from its phone number id.
VAPI_FROM_NUMBER=""

# THE VENDOR AGENT MUST BE CONFIGURED TOO, and the app cannot do it for you. Whether the
# customer asked for a quotation is read from the vendor's post-call analysis, never from the
# transcript — "no, please don't send me a quote" contains the word. Configure these fields on
# the agent (Retell: post_call_analysis_data; Vapi: analysisPlan.structuredDataSchema):
#   customer_asked_for_quote      boolean
#   customer_asked_for_callback   boolean
#   customer_confirmed_renewal    boolean
#   customer_not_interested       boolean
#   seats_discussed               number
# Without them every call is filed with action_taken = none and says so on the record.

# ============================================================
# Voice — Sarvam AI (TTS was already here; STT added 25 Aug 2026)
# ============================================================
# ONE key, both directions. lib/voice/tts.ts (Bulbul) turns a Hindi reminder into a WhatsApp
# voice note; lib/voice/stt.ts (Saaras) turns a customer's voice note into text the sales
# agent can read. The brief offered "Sarvam AI / Deepgram Whisper" — picking the vendor
# already in the stack avoids a second Indic-speech account to keep in credit and in step.
#
# NOT SET on this deployment as of 25 Aug 2026. Both paths are stub-first: with no key, a
# voice note is still received and still stored, it simply is not transcribed and a person
# answers it from the Inbox. Nothing crashes and nothing is lost.
SARVAM_API_KEY=""

# A transcribed seat count is NEVER auto-quoted, whatever this key is set to. "15 log" heard
# as "50 log" is 3.3x the quantity and also crosses a band of the volume rate card, so
# decideAutoSend holds any quote whose seats were heard rather than typed — the agent reads
# the number back to the customer and a person sends. There is no confidence threshold to
# tune here: the provider scores the LANGUAGE, not the words.

# ── Audit C6 (1 Sep 2026): ye 9 vars code me load-bearing the par is file me nahi ──
# Cron routes ka shared bearer (17 routes; unset = 503 fail-closed)
CRON_SECRET=
# tenant_secrets ka envelope-encryption master (unset = tenant keys PLAINTEXT rehti hain)
SECRETS_MASTER_KEY=
# PDF/claim capability-links ka HMAC (unset = SERVICE_ROLE_KEY fallback; dono gayab = sign/verify refuse)
PDF_SIGNING_SECRET=
# Inbound email webhook ka shared secret (header x-inbound-secret)
INBOUND_EMAIL_SECRET=
# Public buy/enquiry pages kis tenant ke catalogue se chalti hain
BUY_PAGE_TENANT_ID=
# Web-push (VAPID) — public half NEXT_PUBLIC_VAPID_PUBLIC_KEY ke saath
VAPID_PRIVATE_KEY=
# Prod escape-hatches — kabhi bhi set karne se pehle do baar socho
ALLOW_QUOTE_PAY_SIMULATION=
ALLOW_DEV_PAGES=
ALLOW_SENTRY_TEST=
