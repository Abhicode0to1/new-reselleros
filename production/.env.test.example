# ─────────────────────────────────────────────────────────────────────────────
# .env.test — unlocks the 70 Playwright tests that currently skip
#
# Copy to `.env.test` (gitignored) and fill in. playwright.config.ts reads it.
# Without this file only the 8 smoke tests run; the RLS cross-tenant suite, the
# money-spine suite and the role-permission suite all skip.
#
# ── READ THIS BEFORE YOU FILL IT IN ──────────────────────────────────────────
#
# There is only ONE Supabase project, and it is production. These suites are not
# read-only: they create leads, build quotes and record payments. Pointing them
# at production means test rows land in the same database as the real business.
#
# What protects the real data is that everything is created inside two dedicated
# test tenants (Test Tenant A / Test Tenant B), and RLS keeps tenants apart. That
# is the same isolation the product sells, so if it fails the tests have found
# something worth knowing. But it IS production, and there is no staging project
# to fall back on. Decide that on purpose.
#
# Safer order:
#   1. npm run backup:db          — take a backup first
#   2. node scripts/setup-e2e-tenants.mjs   — idempotent; creates the 2 tenants
#                                             and their users, nothing else
#   3. npm run test:e2e
#
# Then check the test tenants stayed out of your dashboard: the app scopes
# everything by tenant_id, so Anutech Digital's numbers should not move at all.
# ─────────────────────────────────────────────────────────────────────────────

# Same project URL as .env.local.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=

# Anon key — what the browser uses. Safe to expose; RLS is the real boundary.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=

# Service-role key — BYPASSES RLS. Needed only to create the test auth users.
# Never put this in .env.local's client-side vars and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
